# Copy to the project root as .env, then restart the Node/Vite service.
# Never prefix private keys with VITE_. Never commit .env.

# Text analysis (DeepSeek or another OpenAI-compatible chat API).
ISLAND_ANALYSIS_BASE_URL=https://api.deepseek.com
ISLAND_ANALYSIS_MODEL=deepseek-v4-flash
ISLAND_ANALYSIS_API_KEY=

# Optional image generation: separate provider, not DeepSeek chat.
# Endpoint must support POST <base>/images/generations and data[].b64_json.
# Set the provider's actual model ID, URL and key together.
ISLAND_IMAGE_BASE_URL=
ISLAND_IMAGE_MODEL=
ISLAND_IMAGE_API_KEY=
